<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Electron's own helper processes (renderer, GPU, plugin) under the hardened runtime: the same
    two as the app, because the renderer runs V8 too. The key helper in Contents/Helpers is not
    signed with this; native/macos/build.sh signs it with its own.
  -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
